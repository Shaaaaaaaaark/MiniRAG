# Example variables. For docker compose, copy this file to the repo root as .env.
# For local uvicorn, export these variables in your shell or use config.yaml.
# Never commit real keys, private endpoint URLs, or internal model IDs.

MINIRAG_CHAT_PROVIDER=openai
MINIRAG_CHAT_MODEL=gpt-4o-mini
MINIRAG_CHAT_BASE_URL=https://api.openai.com/v1
MINIRAG_CHAT_API_KEY=

MINIRAG_EMBEDDING_PROVIDER=openai
MINIRAG_EMBEDDING_MODEL=text-embedding-3-small
MINIRAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
MINIRAG_EMBEDDING_API_KEY=
MINIRAG_EMBEDDING_DIMENSIONS=1536

MINIRAG_RERANK_PROVIDER=bailian
MINIRAG_RERANK_MODEL=gte-rerank-v2
MINIRAG_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MINIRAG_RERANK_API_KEY=
